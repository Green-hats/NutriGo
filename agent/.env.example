# NutriGo Agent 配置
# 复制为 .env 后填入真实值
#
# 运行环境：development / production
# 生产环境会强制校验 JWT_SECRET 和 INTERNAL_TOKEN（禁止使用默认值），缺失则启动失败
APP_ENV=development
# AI 相对日期与默认饮食汇总的业务时区，不依赖操作系统时区。
APP_TIMEZONE=Asia/Shanghai

# LLM 相关
LLM_MODEL=openai/qwen3.7-max            # litellm 格式 provider/model，按供应商填写；reasoning_content 为可选输出
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://opencode.ai/zen/go/v1

# 新版照片分析使用 DeepSeek V4.1 Flash（官方 API 标识）。
# 聊天也使用 DeepSeek 官方时自动复用 LLM_API_KEY，否则单独填写此密钥。
FOOD_VISION_MODEL=deepseek-flash
FOOD_VISION_API_KEY=

# Go 后端
GO_BACKEND_URL=http://localhost:3333
INTERNAL_TOKEN=nutri-go-internal-token-dev   # 生产环境必须改为强随机值

# JWT 签名密钥（与 Go 后端 internal/config/jwt.go 保持一致；生产必须改为强随机值）
JWT_SECRET=nutri-go-secret-key-change-in-production

# 数据库
DATABASE_PATH=agent.db

# CORS 白名单（逗号分隔；仅浏览器跨域调试需要，原生 HTTP 不依赖 CORS）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Agent 行为
MAX_AGENT_ITERATIONS=15                 # Agent 循环最多轮数
LLM_TIMEOUT=120                         # 单次 LLM 调用超时(秒)，网络抖动自动重试
CHAT_TIMEOUT=300                        # 整次聊天生成超时(秒)，含流式读取、工具和保存
TOOL_RESULT_MAX_CHARS=2000              # 工具结果超长兜底截断阈值(字符)
MAX_CONTEXT_TOKENS=8000                 # 发给 LLM 的上下文 token 预算
MAX_CONTEXT_MESSAGES=40                 # 发给 LLM 的最大消息条数
TOOL_TIMEOUT=30                         # 单个工具执行超时(秒)
MAX_ACTIVE_PER_USER=1                   # 同一用户同时最多 N 个活跃对话
MAX_MESSAGE_LENGTH=2000                 # 单条用户消息最大字符数
