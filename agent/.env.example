# NutriGo Agent 配置
# 复制为 .env 后填入真实值

# LLM 模型（litellm 格式，需支持 reasoning_content 思维链）
LLM_MODEL=openai/qwen3.7-max
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://opencode.ai/zen/go/v1

# Go 后端
GO_BACKEND_URL=http://localhost:3333
INTERNAL_TOKEN=nutri-go-internal-token-dev

# JWT 签名密钥（与 Go 后端 internal/config/jwt.go 保持一致）
JWT_SECRET=nutri-go-secret-key-change-in-production

# 数据库
DATABASE_PATH=agent.db

# Agent 行为
MAX_AGENT_ITERATIONS=15
