# ============================================================
# NutriGo 生产环境配置示例
# 复制为 .env 并填写真实值，放到 deploy/compose/.env
# docker compose -f deploy/compose/docker-compose.yml up -d --build
# ============================================================

# --- 安全密钥（必须改为强随机值）---
# 生成: openssl rand -hex 32
JWT_SECRET=please-generate-strong-random-secret
INTERNAL_TOKEN=please-generate-strong-random-internal-token

# --- LLM（litellm 格式: provider/model）---
LLM_MODEL=deepseek/deepseek-chat
LLM_API_KEY=sk-your-llm-api-key
# 本地代理/Ollama 时填写；用官方 API 留空
LLM_BASE_URL=

# --- CORS 白名单（前端节点域名）---
CORS_ORIGINS=https://<your-domain>
