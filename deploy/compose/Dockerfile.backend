# syntax=docker/dockerfile:1
# ============================================================
# NutriGo backend — Go + Gin + SQLite
# 构建: golang 多阶段；运行: 精简镜像
# 注意: go-sqlite3 需要 CGO，构建阶段须安装 gcc
# ============================================================

FROM golang:1.26-bookworm AS builder

ARG DEBIAN_MIRROR=http://deb.debian.org
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY backend/go.mod backend/go.sum ./
ARG GOPROXY=https://proxy.golang.org,direct
RUN go mod download

COPY backend/ ./
RUN CGO_ENABLED=1 go build -ldflags="-s -w" -o /out/nutrigo-server ./cmd/server

# ---------- runtime ----------
FROM debian:bookworm-slim

ARG DEBIAN_MIRROR=http://deb.debian.org
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /out/nutrigo-server /usr/local/bin/nutrigo-server

ENV APP_ENV=production

EXPOSE 3333

CMD ["/usr/local/bin/nutrigo-server"]
