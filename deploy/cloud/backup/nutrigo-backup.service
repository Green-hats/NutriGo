[Unit]
Description=NutriGo verified database and image backup
Requires=docker.service
After=docker.service
OnFailure=nutrigo-backup-check.service

[Service]
Type=oneshot
WorkingDirectory=/opt/nutrigo
UMask=0077
ExecStart=/usr/bin/python3 /opt/nutrigo/deploy/cloud/backup/operations.py run
TimeoutStartSec=7200
