# API 域名（不带 https://），DNS 指向服务器；Caddy 自动申请 HTTPS 证书。
API_DOMAIN=api.your-domain.com
# 使用公网 IP 时填写 IP 并选择 Caddyfile.ip，需要 Caddy 2.11+。
CADDY_CONFIG_FILE=./Caddyfile

# 分别运行 openssl rand -hex 32，替换以下两个值。
JWT_SECRET=
INTERNAL_TOKEN=

# 被日记引用时保留；无引用照片按上传时间到期清理。
# 0 仅关闭此到期清理，删除任务重试与未登记文件对账继续执行。
UNATTACHED_IMAGE_RETENTION_DAYS=7
# 直接运行 Compose backup 时使用；定时编排改用 /etc/nutrigo/backup.json 的 keep。
# 新快照通过隔离恢复验证后，保留最近 N 份备份；异地模式还需远端校验。
BACKUP_KEEP=14

# 图片配额（字节/张数）、磁盘低水位和每用户上传令牌桶。
# Go 配置非正数/无效值回退默认值，不会关闭保护。
IMAGE_USER_MAX_BYTES=536870912
IMAGE_USER_MAX_FILES=1000
IMAGE_TOTAL_MAX_BYTES=10737418240
UPLOAD_MIN_FREE_BYTES=2147483648
UPLOAD_RATE_PER_MIN=10
UPLOAD_RATE_BURST=3
# 新旧照片分析共享名额；旧 CLIP 最多 1 个，无等待队列。
PHOTO_MAX_ACTIVE=4
PHOTO_REQUEST_TIMEOUT=60

# AI 的“今天”、相对日期及默认近 7 天汇总，使用此 IANA 时区。
APP_TIMEZONE=Asia/Shanghai

# 仅存在服务器，不能写进 App 的 VITE_* 环境变量。
LLM_MODEL=deepseek/deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=
# 尚无 AI Key / 模型时设置 AI_ENABLED=false、PRELOAD_MODELS=0。
# 基础账号、档案、日记、营养计算仍然可用，AI 对话和照片识别返回明确提示。
AI_ENABLED=true
# 仅启用云端文字对话时，以下两项设为 false，无需下载本地模型。
RAG_ENABLED=true
# 云端建议填已校验的 BGE 模型绝对路径；本地目录只从磁盘加载，不在启动时联网。
RAG_MODEL_PATH=BAAI/bge-small-zh-v1.5
FOOD_RECOGNITION_ENABLED=true
# DeepSeek V4.1 Flash 官方视觉 API；官方聊天配置可复用 LLM_API_KEY。
FOOD_VISION_MODEL=deepseek-flash
FOOD_VISION_API_KEY=
# 可填已校验的本地模型目录，例如 /models/chinese-clip-vit-base-patch16。
FOOD_MODEL_PATH=OFA-Sys/chinese-clip-vit-base-patch16
# 启动时预热菜名向量，完成后服务才就绪。
FOOD_MODEL_PRELOAD=true
# 默认保留原始精度；仅在验证识别效果后才考虑 int8。
FOOD_MODEL_INT8=false
# 按供应商支持的值填写；DeepSeek Flash 可用 none 关闭思考模式。
LLM_REASONING_EFFORT=
# 整次聊天生成的总超时，包含流式读取、工具调用和保存（秒）。
CHAT_TIMEOUT=300
PRELOAD_MODELS=1

# 原生 HTTP 不依赖 CORS。需要浏览器跨域调试时填写准确的来源地址。
CORS_ORIGINS=

# 可选：服务器访问默认软件源较慢时，设置可信镜像，仅影响容器构建。
DEBIAN_MIRROR=http://deb.debian.org
GOPROXY=https://proxy.golang.org,direct
PIP_INDEX_URL=https://pypi.org/simple
