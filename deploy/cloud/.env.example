# API 域名（不带 https://），DNS 指向服务器；Caddy 自动申请 HTTPS 证书。
API_DOMAIN=api.your-domain.com
# 使用公网 IP 时填写 IP 并选择 Caddyfile.ip，需要 Caddy 2.11+。
CADDY_CONFIG_FILE=./Caddyfile

# 分别运行 openssl rand -hex 32，替换以下两个值。
JWT_SECRET=
INTERNAL_TOKEN=

# 仅存在服务器，不能写进 App 的 VITE_* 环境变量。
LLM_MODEL=deepseek/deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=
# 尚无 AI Key / 模型时设置 AI_ENABLED=false、PRELOAD_MODELS=0。
# 基础账号、档案、日记、营养计算仍然可用，AI 对话和照片识别返回明确提示。
AI_ENABLED=true
# 仅启用云端文字对话时，以下两项设为 false，无需下载本地模型。
RAG_ENABLED=true
FOOD_RECOGNITION_ENABLED=true
# 可填已校验的本地模型目录，例如 /models/chinese-clip-vit-base-patch16。
FOOD_MODEL_PATH=OFA-Sys/chinese-clip-vit-base-patch16
# 启动时预热菜名向量，完成后服务才就绪。
FOOD_MODEL_PRELOAD=true
# 默认保留原始精度；仅在验证识别效果后才考虑 int8。
FOOD_MODEL_INT8=false
# 按供应商支持的值填写；DeepSeek Flash 可用 none 关闭思考模式。
LLM_REASONING_EFFORT=
PRELOAD_MODELS=1

# 原生 HTTP 不依赖 CORS。需要浏览器跨域调试时填写准确的来源地址。
CORS_ORIGINS=

# 可选：服务器访问默认软件源较慢时，设置可信镜像，仅影响容器构建。
DEBIAN_MIRROR=http://deb.debian.org
GOPROXY=https://proxy.golang.org,direct
PIP_INDEX_URL=https://pypi.org/simple
